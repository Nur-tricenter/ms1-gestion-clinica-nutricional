#!/bin/sh
# pre-commit: block commits whose staged C# files break .editorconfig
# (tabs-not-spaces, formatting, unused usings). Enable with:
#   git config core.hooksPath .githooks

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs')
[ -z "$files" ] && exit 0

echo "pre-commit: checking staged C# files with dotnet format..."

# shellcheck disable=SC2086
if ! dotnet format GestionClinicaNutricionalService.sln \
		--verify-no-changes --no-restore --verbosity quiet \
		--include $files; then
	echo ""
	echo "pre-commit: style violations found (use TABS, no unused usings)."
	echo "Fix with:  dotnet format GestionClinicaNutricionalService.sln --include <file>"
	echo "then 'git add' the files and commit again."
	exit 1
fi
