<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[GestionClinicaNutricional.Infrastructure]GestionClinicaNutricional.Infrastructure.Migrations.*,[GestionClinicaNutricionalService.WebApi]GestionClinicaNutricionalService.ExcludeHabitoAlimenticioPropertySchemaProcessor</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
